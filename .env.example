VITE_API_BASE_URL=http://localhost:8000

# Backend settings. Copy this file to .env for local development.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CACHE_DIR=backend/cache
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Required only for NASA FIRMS API access. Request a key from NASA FIRMS.
FIRMS_MAP_KEY=

# Required to retrieve NASA SMAP and MODIS samples through the NASA AppEEARS API.
# Create an Earthdata Login account and keep these values server-side only.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Required for NASA GPM IMERG granule downloads. Generate a user token in your
# Earthdata Login profile; do not commit a real token.
EARTHDATA_ACCESS_TOKEN=
